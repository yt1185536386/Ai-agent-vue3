/**
 * 普通 接口返回数据格式  实例：
 */
{
  "errCode": "0", // 状态码 0 表示成功 其他表示失败
  "errMsg": "请求成功", // 状态描述
  "data": {} // 数据
}

/**
 * 分页接口返回数据格式 实例：
 */
 {
    "errCode": "0", // 状态码 0 表示成功 其他表示失败
    "errMsg": "分页查询熔断策略成功", // 状态描述
    "data": [  // 分页数据
        {
            "name": "新增熔断策略11",
            "aliasName": "",
        }
    ],
    "total": 1  // 总记录数
}
