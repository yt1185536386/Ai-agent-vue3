# 模型来源(OpenAI 兼容),chat/嵌入经 Java 网关或直连
BAILIAN_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL_API_KEY=your-bailian-api-key
BAILIAN_MODEL_ENABLE_SEARCH=false
BAILIAN_MODEL_ENABLE_TOOLS=true
MODEL_BASE_URL=https://your-company-llm-gateway.com/v1
MODEL_API_KEY=
MODEL_ENABLE_SEARCH=false
MODEL_ENABLE_TOOLS=true

# 嵌入模型(来源名需在 channels 表或上方 provider 中存在)
EMBED_PROVIDER=bailian
EMBED_MODEL=text-embedding-v3

# 思考/图像/文档能力模型(逗号分隔匹配)
THINKING_MODELS=qwen3,deepseek

# ASR 语音识别(dashscope SDK 直连)
DASHSCOPE_API_KEY=your-dashscope-api-key
ASR_MODEL=paraformer-realtime-v2

# 高德公交工具
AMAP_API_KEY=your-amap-api-key

# 数据库(默认 SQLite,生产建议 MySQL)
DATABASE_URL=sqlite+aiosqlite:///./ai_service.db

# NestJS → ai-service 内部服务密钥(与 NestJS/.env 的 NESTJS_SERVICE_KEY 同值)
NESTJS_SERVICE_KEY=generate-a-random-secret-here

# 内容护栏(可选)
GUARDRAIL_ENABLED=false
GUARDRAIL_CONFIDENCE=0.8
GUARDRAIL_CLASSIFY_MODEL=

# 服务端口与上传目录
PORT=6010
UPLOAD_DIR=./uploads
