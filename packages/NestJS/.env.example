# 公司内部模型的 OpenAI 兼容地址(不含 /chat/completions)
MODEL_BASE_URL=https://your-company-llm-gateway.com/v1
# 内部模型的访问密钥(如网关不需要可留空)
MODEL_API_KEY=
# 实际调用的模型名称
MODEL_NAME=gpt-4o-mini
# 公司网关是否支持联网搜索(网关支持 enable_search 时设为 true)
MODEL_ENABLE_SEARCH=false
# 百炼模型(阿里 dashscope OpenAI 兼容地址)
# BAILIAN_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BAILIAN_MODEL_API_KEY=
# BAILIAN_MODEL_NAME=qwen-plus
# 百炼 qwen 系列原生联网搜索(true 后回答会基于实时搜索结果)
# BAILIAN_MODEL_ENABLE_SEARCH=true
# 支持上传图片的模型(逗号分隔,按名称包含匹配,* 表示全部)
VISION_MODELS=k3
# 支持上传文档的模型
DOC_MODELS=*
# 支持思考模式(enable_thinking)的模型
THINKING_MODELS=k3,qwen3,deepseek
# 本服务端口
PORT=6011
# AI 服务层(FastAPI)地址,chat completions 经它转发到模型
AI_SERVICE_URL=http://localhost:6010
# JWT 密钥与有效期
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d
# NestJS 调用 ai-service 的内部服务密钥
NESTJS_SERVICE_KEY=internal-service-key-between-nestjs-and-ai-service
# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your-mysql-password
DB_DATABASE=ai_agent

# CORS 白名单(逗号分隔;未配置时默认只放行本地开发端口 6012/6013)
# 生产环境必须显式配置,例如: CORS_ORIGINS=https://chat.example.com,https://admin.example.com
CORS_ORIGINS=
# TypeORM 自动同步表结构(建表/改列):仅开发环境开 true,生产必须 false 并使用 migration
DB_SYNCHRONIZE=true
